version 19
clear all
set more off

args root output_root write_log
if `"`output_root'"' == "" local output_root `"`root'"'
if `"`write_log'"' == "" local write_log 1

* Generated tables must exist under output_root. The two supplied appendix
* tables are checked separately under the release root.
foreach output in table1.tex table2.tex table3.tex table4.tex tableS3.tex tableS4.tex tableS5.tex {
    confirm file `"`output_root'/tables/`output'"'
}
confirm file `"`root'/tables/t_des_census.tex"'
confirm file `"`root'/tables/t_interpolation.tex"'

* Supplied figures.
confirm file `"`root'/figures/main/figure1_study_area.jpg"'
confirm file `"`root'/figures/appendix/figureA2_grid_connection_map.jpg"'
confirm file `"`root'/figures/appendix/figureA5_GDP_comparison.png"'

* Figures generated by the current analysis run.
confirm file `"`output_root'/figures/main/figure2_deforestation_event_study.pdf"'
confirm file `"`output_root'/figures/main/figure3_socioeconomic_event_studies.png"'
confirm file `"`output_root'/figures/appendix/figureA1_summary_ATT.png"'
confirm file `"`output_root'/figures/appendix/figureA3_deforestation_sensitivity.png"'
confirm file `"`output_root'/figures/appendix/figureA4_socioeconomic_sensitivity.png"'

if `write_log' == 1 {
    tempname handle
    file open `handle' using `"`root'/logs/verification.txt"', write text replace
    file write `handle' "PASS: all generated article and appendix outputs exist" _n
    file write `handle' "PASS: all supplied static article and appendix outputs exist" _n
    file write `handle' "NOTE: generated outputs were staged and checked before release files were replaced" _n
    file write `handle' "NOTE: numerical values are recorded in the generated LaTeX tables and analysis.log" _n
    file close `handle'
}
display as result "Output verification passed."
exit
